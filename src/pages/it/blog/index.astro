---
export const prerender = false;

import matter from "gray-matter";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../../../layouts/Layout.astro";
import { t } from "../../../i18n";

const locale = "it";

interface PostMeta {
  slug: string;
  title: string;
  date: string;
  description?: string;
}

const POSTS_PREFIX = "posts/";

let posts: PostMeta[] = [];

try {
  const runtime = (Astro.locals as { runtime?: { env?: Env } }).runtime;
  const bucket = runtime?.env?.BLOG_BUCKET;

  if (bucket) {
    const listed = await bucket.list({ prefix: POSTS_PREFIX });
    const objects = listed.objects.filter((obj) => obj.key.endsWith(".md"));

    const postPromises = objects.map(async (obj) => {
      const r2Object = await bucket.get(obj.key);
      if (!r2Object) return null;
      const text = await r2Object.text();
      const { data } = matter(text);
      const slug = obj.key.replace(POSTS_PREFIX, "").replace(/\.md$/, "");
      return {
        slug,
        title: (data.title as string) ?? slug,
        date: (data.date as string) ?? obj.uploaded?.toISOString() ?? "",
        description: data.description as string | undefined,
      };
    });

    const results = await Promise.all(postPromises);
    posts = results
      .filter((p): p is PostMeta => p !== null)
      .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
  }
} catch (err) {
  console.error("Failed to load blog posts:", err);
}

const blogIndexPath = getRelativeLocaleUrl(locale, "blog");
const dateLocale = locale === "it" ? "it-IT" : "en-US";
---

<Layout
  title={t(locale, "blog.metaTitle")}
  description={t(locale, "blog.metaDescription")}
  locale={locale}
>
  <section class="mx-auto w-[min(1120px,calc(100%-2rem))] py-32 md:py-40">
    <header data-reveal class="mb-16 max-w-xl md:mb-24">
      <p class="mb-4 text-[11px] font-medium uppercase tracking-[0.22em] text-copper">
        Blog
      </p>
      <h1 class="font-display text-5xl font-medium tracking-tight text-balance sm:text-6xl">
        {t(locale, "blog.title")}
      </h1>
      <p class="mt-5 max-w-[46ch] text-lg leading-relaxed text-mute">
        {t(locale, "blog.intro")}
      </p>
    </header>
    {posts.length > 0 ? (
      <ul class="divide-y divide-line">
        {posts.map((post) => (
          <li data-reveal>
            <a
              href={`${blogIndexPath}/${post.slug}`.replace(/\/+/g, "/")}
              class="group block py-8 transition-transform duration-700 ease-soft md:py-10"
            >
              <h2 class="font-display text-2xl font-medium tracking-tight group-hover:text-copper md:text-3xl">
                {post.title}
              </h2>
              <time class="mt-2 block font-mono text-xs tabular-nums text-mute" datetime={post.date}>
                {new Date(post.date).toLocaleDateString(dateLocale, {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              {post.description && (
                <p class="mt-3 max-w-[58ch] text-mute">{post.description}</p>
              )}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div data-reveal class="bezel max-w-xl">
        <div class="bezel-inner">
          <p class="text-ink">{t(locale, "blog.noPosts")}</p>
          <p class="mt-3 text-sm text-mute">
            {t(locale, "blog.noPostsHintPrefix")}
            <code class="mx-1 font-mono text-ink">posts/</code>
            {t(locale, "blog.noPostsHintSuffix")}
          </p>
        </div>
      </div>
    )}
  </section>
</Layout>
