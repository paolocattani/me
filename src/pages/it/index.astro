---
import Layout from "../../layouts/Layout.astro";
import HomeContent from "../../components/HomeContent.astro";
import { t } from "../../i18n";

const locale = "it";
const FORMSPREE_ENDPOINT = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? "https://formspree.io/f/YOUR_FORM_ID";
---

<Layout
  title={t(locale, "home.metaTitle")}
  description={t(locale, "home.metaDescription")}
  locale={locale}
>
  <HomeContent locale={locale} formspreeEndpoint={FORMSPREE_ENDPOINT} />
</Layout>
