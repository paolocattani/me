---
export const prerender = false;

import matter from "gray-matter";
import { marked } from "marked";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../../../layouts/Layout.astro";
import { t } from "../../../i18n";

const locale = "en";

const POSTS_PREFIX = "posts/";

const slug = Astro.params.slug ?? "";
const key = `${POSTS_PREFIX}${slug}.md`;

let content: string | null = null;
let title = slug;
let description: string | undefined;
let date: string | undefined;

try {
  const runtime = (Astro.locals as { runtime?: { env?: Env } }).runtime;
  const bucket = runtime?.env?.BLOG_BUCKET;

  if (bucket) {
    const r2Object = await bucket.get(key);
    if (r2Object) {
      const text = await r2Object.text();
      const { data, content: body } = matter(text);
      title = (data.title as string) ?? slug;
      description = data.description as string | undefined;
      date = data.date as string | undefined;
      content = marked(body) as string;
    }
  }
} catch (err) {
  console.error("Failed to load blog post:", err);
}

const blogIndexPath = getRelativeLocaleUrl(locale, "blog");

if (!content) {
  return Astro.redirect(blogIndexPath);
}

const dateLocale = locale === "it" ? "it-IT" : "en-US";
---

<Layout title={`${title} | Paolo Cattani`} description={description ?? title} locale={locale}>
  <article class="mx-auto w-[min(720px,calc(100%-2rem))] py-32 md:py-40">
    <header data-reveal class="mb-12">
      <a href={blogIndexPath} class="btn-ghost mb-8 px-0 text-sm">
        {t(locale, "blog.backToBlog")}
      </a>
      <h1 class="font-display text-4xl font-medium tracking-tight text-balance sm:text-5xl">
        {title}
      </h1>
      {date && (
        <time class="mt-4 block font-mono text-xs tabular-nums text-mute" datetime={date}>
          {new Date(date).toLocaleDateString(dateLocale, {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      )}
    </header>
    <div
      class="prose max-w-none prose-headings:font-display prose-headings:font-medium prose-headings:tracking-tight prose-headings:text-ink prose-p:text-ink/85 prose-a:text-copper prose-a:no-underline hover:prose-a:underline prose-strong:text-ink prose-code:rounded prose-code:bg-ink/5 prose-code:px-1 prose-code:text-copper prose-pre:bg-ink prose-pre:text-paper"
      set:html={content}
    />
    <footer class="mt-16 border-t border-line pt-8">
      <a href={blogIndexPath} class="btn-ghost px-0">
        {t(locale, "blog.backToBlog")}
      </a>
    </footer>
  </article>
</Layout>
