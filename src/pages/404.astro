---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../layouts/Layout.astro";
import { resolveLocale, t } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const homeHref = getRelativeLocaleUrl(locale);
---

<Layout
  title={`${t(locale, "notFound.title")} | Paolo Cattani`}
  description={t(locale, "notFound.body")}
  locale={locale}
>
  <section class="mx-auto flex min-h-[80dvh] w-[min(1120px,calc(100%-2rem))] flex-col justify-center py-32">
    <p class="mb-5 text-[11px] font-medium uppercase tracking-[0.22em] text-copper">404</p>
    <h1 class="font-display max-w-[12ch] text-5xl font-medium tracking-tight text-balance sm:text-7xl">
      {t(locale, "notFound.title")}
    </h1>
    <p class="mt-6 max-w-[36ch] text-lg text-mute">
      {t(locale, "notFound.body")}
    </p>
    <a href={homeHref} class="btn-primary mt-10 w-fit">
      {t(locale, "notFound.home")}
      <span class="btn-icon">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M4 12 12 4M6 4h6v6" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>
  </section>
</Layout>
